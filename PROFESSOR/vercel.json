{
  "version": 2,
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.9.0" },
    "php/*.php": { "runtime": "vercel-php@0.9.0" },
    "*.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/img/(.*)", "dest": "/img/$1" },
    { "src": "/banco/(.*)", "status": 403 },
    { "handle": "filesystem" }
  ]
}