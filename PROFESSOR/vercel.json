{
  "version": 2,
  "builds": [
    { "src": "api/*.php", "use": "vercel-php@0.9.0" },
    { "src": "php/*.php", "use": "vercel-php@0.9.0" },
    { "src": "*.php", "use": "vercel-php@0.9.0" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "img/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/banco/(.*)", "status": 403 },
    { "handle": "filesystem" }
  ]
}